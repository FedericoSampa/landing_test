# ===== Plantilla de variables de entorno =====
# Copiá este archivo a `.env` (sin .example) y completá los valores.
# `.env` está gitignored — NUNCA lo subas al repo.

# --- Anthropic (Ava IA chat) ---
# Backend-only. NO usa prefijo VITE_ porque NO debe exponerse al navegador.
# Sacar de: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Supabase (form de inscripción - para más adelante) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email transaccional (para más adelante) ---
RESEND_API_KEY=
EMAIL_FROM=academy@avalith.net
